#include <stdio.h>

int main() {
    int a[100], n, i;
    int largest, second;
    
    printf("Enter array size: ");
    scanf("%d", &n);

    if (n < 2 || n > 100) {
        printf("Invalid array size");
        return 0;
    }

    printf("Enter array elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    largest = second = 0;
    
    for (i = 0; i < n; i++) {
        if (i == 0 || a[i] > largest) {
            if (i > 0)
                second = largest;
            largest = a[i];
        } else if (a[i] < largest &&
                   (second == 0 || a[i] > second)) {
            second = a[i];
        }
    }

    if (second == 0)
        printf("Second-largest element not found");
    else
        printf("Second-largest element = %d", second);

    return 0;
}
